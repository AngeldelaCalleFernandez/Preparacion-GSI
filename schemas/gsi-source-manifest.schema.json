{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "retrieved_at",
    "authorized_root",
    "official_control",
    "canonical_documents",
    "topics",
    "discrepancies",
    "policy"
  ],
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "authorized_root": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "official_control": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "canonical_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "drive_id",
          "version",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "drive_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "minItems": 8,
      "maxItems": 8
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "title",
          "source_id",
          "document_id",
          "drive_id",
          "url",
          "locator",
          "version",
          "reviewed_at",
          "source_type",
          "study_characters",
          "summary_characters",
          "markdown_path",
          "html_path",
          "study_sha256",
          "review_source_id"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "pattern": "^B[1-4]-T[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "drive_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "const": "V2.1"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "source_type": {
            "const": "curated"
          },
          "study_characters": {
            "type": "integer",
            "minimum": 1500
          },
          "summary_characters": {
            "type": "integer",
            "minimum": 100
          },
          "markdown_path": {
            "type": "string",
            "minLength": 1
          },
          "html_path": {
            "type": "string",
            "minLength": 1
          },
          "study_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "review_source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 57,
      "maxItems": 57
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
