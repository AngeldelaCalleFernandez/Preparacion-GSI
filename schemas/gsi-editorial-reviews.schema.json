{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewed_at",
    "reviewer",
    "reviewer_type",
    "method",
    "status",
    "sample_ids",
    "reviews"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_type": {
      "enum": [
        "human",
        "ai"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending_human_review",
        "reviewed"
      ]
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "record_sha256",
          "evidence_sha256",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AI-GSI-(?:P1-)?B[1-4]-T[0-9]{2}-[0-9]{3}$"
          },
          "decision": {
            "enum": [
              "pending_review",
              "accepted",
              "rejected"
            ]
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "statement",
        "scope",
        "record_count",
        "records_sha256"
      ],
      "properties": {
        "received_at": {
          "type": "string",
          "format": "date"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "records_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
