{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "inspected_at",
    "main",
    "auxiliary"
  ],
  "properties": {
    "root": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "inspected_at": {
      "type": "string",
      "format": "date"
    },
    "main": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "parent_id",
          "relative_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "auxiliary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "roots",
        "items",
        "errors"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "observed_parent_id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "observed_parent_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
