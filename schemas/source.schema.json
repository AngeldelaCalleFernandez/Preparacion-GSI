{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "sources"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/convertedSource"
          },
          {
            "$ref": "#/$defs/technicalPrimarySource"
          },
          {
            "$ref": "#/$defs/corpusSource"
          }
        ]
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "schema_version",
        "data_version",
        "updated_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "data_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "convertedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "conversion_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DOC-[A-Z0-9-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)documents/markdown/.+\\.md$"
        },
        "kind": {
          "enum": [
            "project_index",
            "links_index",
            "convocatoria",
            "program",
            "legal_basis",
            "normative_compendium",
            "exam_questionnaire",
            "answer_key",
            "exam_criteria",
            "score_notice",
            "readme"
          ]
        },
        "conversion_status": {
          "const": "converted"
        }
      }
    },
    "convertedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "official_status",
        "url",
        "published_at",
        "reviewed_at",
        "block_ids",
        "topic_ids",
        "mapping_status",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "official_status": {
          "enum": [
            "official",
            "official_provisional",
            "official_archive",
            "reference"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B[1-4]$"
          }
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B[1-4]-T\\d{2}$"
          }
        },
        "mapping_status": {
          "enum": [
            "mapped",
            "partial",
            "pending_review"
          ]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/convertedDocument"
          }
        }
      }
    },
    "technicalPrimarySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceKind",
        "manifestSourceId",
        "documentId",
        "title",
        "publisher",
        "officialStatus",
        "canonicalUrl",
        "authorityStatus",
        "version",
        "retrievedAt",
        "licenseStatus",
        "redistributionStatus",
        "localAvailability",
        "publicLocalPath",
        "checksum",
        "blockIds",
        "topicIds",
        "mappingStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-TECH-[A-Z0-9-]+$"
        },
        "sourceKind": {
          "const": "technical-primary-source"
        },
        "manifestSourceId": {
          "type": "string",
          "pattern": "^SRC-TECH-[A-Z0-9-]+$"
        },
        "documentId": {
          "type": "string",
          "pattern": "^DOC-TECH-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "officialStatus": {
          "const": "reference"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        },
        "authorityStatus": {
          "const": "official-primary"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "licenseStatus": {
          "enum": [
            "public-permitted",
            "private-only"
          ]
        },
        "redistributionStatus": {
          "enum": [
            "public",
            "private"
          ]
        },
        "localAvailability": {
          "enum": [
            "public",
            "private"
          ]
        },
        "publicLocalPath": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)documents/sources/technical/public/.+"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^B[1-4]$"
          },
          "uniqueItems": true
        },
        "topicIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^B[1-4]-T\\d{2}$"
          },
          "uniqueItems": true
        },
        "mappingStatus": {
          "enum": [
            "mapped",
            "partial",
            "pending_review"
          ]
        }
      }
    },
    "corpusDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "conversion_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DOC-[A-Z0-9-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)documents/markdown/.+\\.md$"
        },
        "kind": {
          "enum": [
            "study_notes",
            "review_summary",
            "practice",
            "questions",
            "program"
          ]
        },
        "conversion_status": {
          "const": "converted"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "corpusSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceKind",
        "title",
        "publisher",
        "official_status",
        "url",
        "drive_id",
        "version",
        "reviewed_at",
        "block_ids",
        "topic_ids",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "sourceKind": {
          "const": "corpus-source"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "official_status": {
          "enum": [
            "reference",
            "official"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "drive_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B[1-4]$"
          },
          "uniqueItems": true
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B[1-4]-T\\d{2}$"
          },
          "uniqueItems": true
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corpusDocument"
          }
        }
      }
    }
  }
}
