{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewed_at",
    "drive_id",
    "url",
    "snapshot",
    "sha256",
    "program_rows",
    "distribution",
    "decision",
    "differences",
    "catalog_discrepancy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "drive_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "program_rows": {
      "const": 57
    },
    "distribution": {
      "const": [
        10,
        16,
        15,
        16
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "auxiliary",
          "decision"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "pattern": "^B[1-4]-T[0-9]{2}$"
          },
          "auxiliary": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "catalog_discrepancy": {
      "type": "string",
      "minLength": 1
    }
  }
}
