{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "blocks", "topics"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "data_version", "updated_at", "opposition_id", "syllabus_id", "total_topics", "plan_start", "notice"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "data_version": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date"},
        "opposition_id": {"const": "OPP-GSI"},
        "syllabus_id": {"const": "SYL-GSI-2025"},
        "total_topics": {"const": 57},
        "plan_start": {"type": "string", "format": "date"},
        "notice": {"type": "string", "minLength": 1}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "block_id", "name", "topic_count", "support_url"],
        "properties": {
          "code": {"enum": ["I", "II", "III", "IV"]},
          "block_id": {"pattern": "^B[1-4]$"},
          "name": {"type": "string", "minLength": 1},
          "topic_count": {"type": "integer", "minimum": 10, "maximum": 16},
          "support_url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 57,
      "maxItems": 57,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "topic_id", "block_id", "planned_weeks"],
        "properties": {
          "code": {"type": "string", "pattern": "^(I|II|III|IV)\\.[0-9]{2}$"},
          "topic_id": {"type": "string", "pattern": "^B[1-4]-T[0-9]{2}$"},
          "block_id": {"type": "string", "pattern": "^B[1-4]$"},
          "planned_weeks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 52}
          }
        }
      }
    }
  }
}
