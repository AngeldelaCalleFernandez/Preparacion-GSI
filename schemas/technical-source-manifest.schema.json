{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "sources"],
  "properties": {
    "metadata": {"$ref": "#/$defs/metadata"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "date": {"type": "string", "format": "date"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)documents/sources/technical/(?:public|private)/.+$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "schemaVersion", "updatedAt"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "updatedAt": {"$ref": "#/$defs/date"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceUrl", "notes"],
      "properties": {
        "status": {"enum": ["public-permitted", "private-only", "pending"]},
        "evidenceUrl": {"type": "string", "format": "uri"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representationId", "format", "normative", "localPath", "sha256", "mediaType", "sizeBytes"],
      "properties": {
        "representationId": {"type": "string", "pattern": "^REP-TECH-[A-Z0-9-]+$"},
        "format": {"enum": ["text/html", "text/plain", "application/xml", "application/pdf"]},
        "normative": {"type": "boolean"},
        "localPath": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "representationOf": {"type": ["string", "null"], "pattern": "^SRC-TECH-[A-Z0-9-]+$"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionId", "retrievedAt", "titleObserved", "updatedAtObserved", "localPath", "sha256", "mediaType", "sizeBytes", "previousRevisionId", "representations"],
      "properties": {
        "revisionId": {"type": "string", "pattern": "^SRC-TECH-[A-Z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-[1-9][0-9]*)?$"},
        "retrievedAt": {"$ref": "#/$defs/date"},
        "titleObserved": {"type": "string", "minLength": 1},
        "updatedAtObserved": {"type": ["string", "null"], "format": "date"},
        "localPath": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "previousRevisionId": {"type": ["string", "null"], "pattern": "^SRC-TECH-[A-Z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-[1-9][0-9]*)?$"},
        "representations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/representation"}}
      }
    },
    "plannedRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionId", "retrievedAt", "downloadUrl", "targetPath", "expectedMediaTypes", "maxBytes", "titleObserved", "updatedAtObserved"],
      "properties": {
        "revisionId": {"type": "string", "pattern": "^SRC-TECH-[A-Z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-[1-9][0-9]*)?$"},
        "retrievedAt": {"$ref": "#/$defs/date"},
        "downloadUrl": {"type": "string", "format": "uri"},
        "targetPath": {"$ref": "#/$defs/relativePath"},
        "expectedMediaTypes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 25000000},
        "titleObserved": {"type": "string", "minLength": 1},
        "updatedAtObserved": {"type": ["string", "null"], "format": "date"}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "locator"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "documentId", "title", "publisher", "sourceType", "authorityStatus", "canonicalUrl", "metadataUrl", "version", "normativeFormat", "publicationStage", "publicationStatus", "supersededBy", "primary", "acquisitionMode", "license", "redistributionStatus", "localAvailability", "blockIds", "topicIds", "verifiedLocators", "revisions", "plannedRevision", "notes"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^SRC-TECH-[A-Z0-9-]+$"},
        "documentId": {"type": "string", "pattern": "^DOC-TECH-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "sourceType": {"enum": ["standard", "rfc", "official-documentation", "official-manual", "official-guidance"]},
        "authorityStatus": {"enum": ["official-primary", "official-historical", "discovery-only"]},
        "canonicalUrl": {"type": "string", "format": "uri"},
        "metadataUrl": {"type": ["string", "null"], "format": "uri"},
        "version": {"type": "string", "minLength": 1},
        "normativeFormat": {"enum": ["text/html", "text/plain", "application/xml", "application/pdf"]},
        "publicationStage": {"enum": ["standard", "rfc", "documentation", "internet-draft"]},
        "publicationStatus": {"enum": ["current", "obsolete", "candidate", "manual-acquisition-required"]},
        "supersededBy": {"type": ["string", "null"], "pattern": "^SRC-TECH-[A-Z0-9-]+$"},
        "primary": {"type": "boolean"},
        "acquisitionMode": {"enum": ["automated", "manual"]},
        "license": {"$ref": "#/$defs/license"},
        "redistributionStatus": {"enum": ["public", "private", "metadata-only"]},
        "localAvailability": {"enum": ["public", "private", "not-acquired"]},
        "blockIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^B[1-4]$"}, "uniqueItems": true},
        "topicIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^B[1-4]-T\\d{2}$"}, "uniqueItems": true},
        "verifiedLocators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}},
        "plannedRevision": {"anyOf": [{"$ref": "#/$defs/plannedRevision"}, {"type": "null"}]},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
