{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "date",
    "opposition_id",
    "topic_count",
    "distribution",
    "question_totals",
    "topics",
    "release_ready",
    "blockers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "opposition_id": {
      "const": "OPP-GSI"
    },
    "topic_count": {
      "const": 57
    },
    "distribution": {
      "const": [
        10,
        16,
        15,
        16
      ]
    },
    "question_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "active",
        "pending",
        "by_origin",
        "by_block"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "active": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "by_origin": {
          "type": "object"
        },
        "by_block": {
          "type": "object"
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "study_characters",
          "has_source",
          "questions",
          "active",
          "pending",
          "minimum_met"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "pattern": "^B[1-4]-T[0-9]{2}$"
          },
          "study_characters": {
            "type": "integer",
            "minimum": 1500
          },
          "has_source": {
            "const": true
          },
          "questions": {
            "type": "integer"
          },
          "active": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "minimum_met": {
            "type": "boolean"
          }
        }
      },
      "minItems": 57,
      "maxItems": 57
    },
    "release_ready": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
