{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "updated_at", "exams"],
  "properties": {
    "version": {"const": 1}, "updated_at": {"type": "string", "format": "date"},
    "exams": {"type": "array", "items": {"$ref": "#/$defs/exam"}}
  },
  "$defs": {
    "numbers": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 100}},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "url", "original", "markdown", "original_sha256", "markdown_sha256"],
      "properties": {
        "kind": {"enum": ["questionnaire", "answer_key", "written", "criteria"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://sede\\.inap\\.gob\\.es/"},
        "original": {"type": "string", "pattern": "^documents/originals/gsi-official/"},
        "markdown": {"type": "string", "pattern": "^documents/markdown/gsi-official/"},
        "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "markdown_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "exam": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "year", "title", "page_url", "key_status", "duration_seconds", "question_count", "reserve_count", "written_question_count", "written_duration_seconds", "documents", "question_ids", "annulled_numbers", "used_reserve_numbers", "annulled_questions", "note"],
      "properties": {
        "id": {"type": "string", "pattern": "^GSI-INAP-[0-9]{4}$"},
        "year": {"type": "integer", "minimum": 2000}, "title": {"type": "string", "minLength": 1},
        "page_url": {"type": "string", "format": "uri", "pattern": "^https://sede\\.inap\\.gob\\.es/"},
        "key_status": {"enum": ["provisional", "definitive"]},
        "duration_seconds": {"const": 5400}, "question_count": {"const": 100}, "reserve_count": {"const": 5},
        "written_question_count": {"const": 5}, "written_duration_seconds": {"const": 10800},
        "documents": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/document"}},
        "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^OFF-GSI-INAP-[0-9]{4}-[QR][0-9]{3}$"}},
        "annulled_numbers": {"$ref": "#/$defs/numbers"}, "used_reserve_numbers": {"$ref": "#/$defs/numbers"},
        "annulled_questions": {"type": "array", "items": {"type": "object"}},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"key_status": {"const": "definitive"}}}, "then": {"properties": {"question_ids": {"minItems": 100, "maxItems": 100}}}, "else": {"properties": {"question_ids": {"maxItems": 0}}}}]
    }
  }
}
