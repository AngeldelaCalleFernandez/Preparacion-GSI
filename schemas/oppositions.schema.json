{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "syllabi_catalog_path", "oppositions"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/version"},
    "catalog_version": {"$ref": "#/$defs/version"},
    "syllabi_catalog_path": {"$ref": "#/$defs/relative_path"},
    "oppositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/opposition"}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "non_empty": {"type": "string", "minLength": 1},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "program_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_id", "document_id", "document_path", "locator"],
      "properties": {
        "status": {"enum": ["cataloged", "located-not-extracted", "unknown"]},
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "document_id": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "document_path": {"$ref": "#/$defs/relative_path"},
        "locator": {"$ref": "#/$defs/non_empty"}
      }
    },
    "opposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "short_code", "official_name", "status", "runtime_status",
        "runtime_available", "has_legacy_operational_syllabus", "syllabus_ids",
        "program_location"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^OPP-[A-Z][A-Z0-9-]*$"},
        "short_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
        "official_name": {"$ref": "#/$defs/non_empty"},
        "status": {"enum": ["active", "planned", "retired"]},
        "runtime_status": {"enum": ["legacy-operational", "catalog-operational", "planned", "unavailable"]},
        "runtime_available": {"type": "boolean"},
        "has_legacy_operational_syllabus": {"type": "boolean"},
        "syllabus_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SYL-[A-Z0-9-]+$"}
        },
        "program_location": {"$ref": "#/$defs/program_location"}
      }
    }
  }
}
