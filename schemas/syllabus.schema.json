{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "blocks"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "schema_version", "data_version", "updated_at", "official_program_source_id", "official_program_document_id", "official_program_date"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "data_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "updated_at": {"type": "string", "format": "date"},
        "official_program_source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "official_program_document_id": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "official_program_date": {"type": "string", "format": "date"}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "rawReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "document_id", "locator", "reviewed_at"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "document_id": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "locator": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "summaries", "flashcards", "updates", "official_tests", "ai_tests"],
      "properties": {
        "raw": {"type": "array", "items": {"$ref": "#/$defs/rawReference"}},
        "summaries": {"type": "array"},
        "flashcards": {"type": "array"},
        "updates": {"type": "array"},
        "official_tests": {"type": "array"},
        "ai_tests": {"type": "array"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title", "status", "source_ids", "content"],
      "properties": {
        "id": {"type": "string", "pattern": "^B[1-4]-T\\d{2}$"},
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "retired"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
        "content": {"$ref": "#/$defs/content"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title", "status", "topics"],
      "properties": {
        "id": {"type": "string", "pattern": "^B[1-4]$"},
        "number": {"type": "integer", "minimum": 1, "maximum": 4},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "retired"]},
        "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topic"}}
      }
    }
  }
}
